{
  "name": "epsilon-build",
  "build": {
    "context": "..",
    "dockerfile": "../tools/Dockerfile.device"
  },
  "workspaceFolder": "/workspaces/epsilon",
  "remoteEnv": {
    "PYTHON": "/runner/.venv/bin/python",
    "DISPLAY": "host.docker.internal:0",
    "MAKEFLAGS": "SHELL=/bin/bash"
  },
  "postCreateCommand": "git config --global --add safe.directory /workspaces/epsilon"
}
